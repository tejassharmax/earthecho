# Copy to backend/.env (never commit .env).
# Users of the app never log in. The SERVER uses one Earthdata token to read NISAR
# source files for the deep "Investigate" analysis. Everything else works without it.
#
# Create a token: https://urs.earthdata.nasa.gov  ->  Generate Token  (valid ~60 days)
EARTHDATA_TOKEN=

# Optional
MAX_DATES=12
